# Copie para hajan.env (na mesma pasta do app.py) e preencha.
# O hajan.env não vai para o repositório.

# Firebase: bucket do Storage e caminho do .json da conta de serviço.
FIREBASE_STORAGE_BUCKET=sistema-hajan.firebasestorage.app
FIREBASE_PROJECT_ID=sistema-hajan
FIREBASE_CREDENTIALS=C:\HAJAN\credenciais\firebase-conta-servico.json

# Opcional: também salvar os PDFs numa pasta local, além do Firebase.
# HAJAN_PDF_DIR=D:\Pedidos
